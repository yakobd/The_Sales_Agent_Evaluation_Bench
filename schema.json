{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tenacious-Bench Task Schema v0.1.1",
  "description": "One task = the inputs a B2B outreach writer is allowed to see (hiring signal brief, bench summary, conversation history), a stored candidate email with its label, and the machine-checkable ground truth used by scoring_evaluator.py. A task can be used two ways: (1) as an evaluator test case, scoring candidate_output and comparing with is_passing; (2) as a generation benchmark, giving input to a model and scoring its email against ground_truth.",
  "type": "object",
  "required": [
    "task_id",
    "source_mode",
    "difficulty",
    "variant",
    "is_passing",
    "input",
    "candidate_output",
    "ground_truth",
    "rubric",
    "metadata"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TB-(?:[A-Z]{1,3})?[0-9]{2,4}$",
      "description": "TB-0xx trace-derived, TB-Pxxx programmatic, TB-LLMxxx multi-LLM synthesis, TB-HAxxx hand-authored adversarial, TB-SGxx Tenacious style-guide draft"
    },
    "source_mode": {
      "type": "string",
      "enum": [
        "trace_derived",
        "programmatic",
        "multi_llm_synthesis",
        "hand_authored"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "variant": {
      "type": "string",
      "description": "generator-specific sub-type, e.g. style_guide_good, hand_authored_adversarial"
    },
    "is_passing": {
      "type": "boolean",
      "description": "label for candidate_output; who assigned it is in metadata.label_source"
    },
    "style_guide_id": {
      "type": "string"
    },
    "probe_label": {
      "type": "string"
    },
    "generator_model": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "description": "Everything the writer may use. Must not contain the label or authoring notes.",
      "required": [
        "hiring_signal_brief",
        "bench_summary",
        "instruction",
        "email_type",
        "prior_thread"
      ],
      "additionalProperties": false,
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 10
        },
        "email_type": {
          "type": "string",
          "enum": [
            "cold",
            "reply",
            "re_engagement",
            "follow_up",
            "referral"
          ]
        },
        "prior_thread": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from"
            ],
            "properties": {
              "from": {
                "type": "string",
                "enum": [
                  "prospect",
                  "tenacious",
                  "meeting_notes"
                ]
              },
              "body": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "channel": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "days_ago": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "hiring_signal_brief": {
          "type": "object",
          "description": "Week 10 enrichment output (agent/enrichment/pipeline.py), possibly with reconstructed fields",
          "required": [
            "prospect",
            "icp_classification",
            "firmographics",
            "ai_maturity",
            "layoff_signal",
            "leadership_signal"
          ],
          "properties": {
            "prospect": {
              "type": "string",
              "minLength": 1
            },
            "icp_classification": {
              "type": "object",
              "required": [
                "segment",
                "segment_name",
                "confidence",
                "reasons"
              ],
              "properties": {
                "segment": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                },
                "segment_name": {
                  "type": "string"
                },
                "confidence": {
                  "type": "string",
                  "enum": [
                    "high",
                    "medium",
                    "low",
                    "very_low"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "firmographics": {
              "type": "object"
            },
            "ai_maturity": {
              "type": "object",
              "required": [
                "ai_maturity_score"
              ],
              "properties": {
                "ai_maturity_score": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "confidence": {
                  "type": "string"
                }
              }
            },
            "layoff_signal": {
              "type": "object",
              "required": [
                "layoff_detected"
              ],
              "properties": {
                "layoff_detected": {
                  "type": "boolean"
                }
              }
            },
            "leadership_signal": {
              "type": "object",
              "required": [
                "leadership_change_detected"
              ],
              "properties": {
                "leadership_change_detected": {
                  "type": "boolean"
                }
              }
            },
            "funding": {
              "type": [
                "object",
                "null"
              ]
            },
            "job_post_signal": {
              "type": [
                "object",
                "null"
              ]
            },
            "sector_layoff_signal": {
              "type": "object"
            },
            "team": {
              "type": "object"
            },
            "referral": {
              "type": "object"
            }
          }
        },
        "bench_summary": {
          "type": "object",
          "required": [
            "available"
          ],
          "properties": {
            "total_engineers": {
              "type": "integer",
              "minimum": 0
            },
            "available": {
              "type": "integer",
              "minimum": 0
            },
            "stacks": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "competitor_gap_brief": {
          "type": "object",
          "description": "Week 10 competitor_gap output; when peers carry a sector, the evaluator checks sector match (probe P33)",
          "properties": {
            "prospect_sector": {
              "type": "string"
            },
            "selection_method": {
              "type": "string"
            },
            "finding": {
              "type": "string"
            },
            "peers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "sector": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "candidate_output": {
      "type": "object",
      "required": [
        "subject",
        "body"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "required": [
        "required_signals",
        "forbidden_phrases",
        "max_subject_length",
        "must_end_with_cta"
      ],
      "properties": {
        "required_signals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "task-specific signals; generic words are ignored by the evaluator"
        },
        "forbidden_phrases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_subject_length": {
          "type": "integer",
          "minimum": 1
        },
        "must_end_with_cta": {
          "type": "boolean"
        },
        "max_body_words": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rubric": {
      "type": "object",
      "description": "legacy v0.1 rubric descriptor; scoring logic lives in scoring_evaluator.py"
    },
    "metadata": {
      "type": "object",
      "required": [
        "created_at",
        "partition",
        "probe_ids",
        "label_source",
        "dataset_version"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "partition": {
          "type": "string",
          "enum": [
            "train",
            "dev",
            "held_out"
          ]
        },
        "probe_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P[0-9]{2}$"
          }
        },
        "label_source": {
          "type": "string",
          "enum": [
            "human_author",
            "tenacious_style_guide",
            "evaluator_v0.2"
          ]
        },
        "dataset_version": {
          "type": "string"
        },
        "source_trace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "judge_score": {
          "type": [
            "number",
            "null"
          ],
          "description": "null: no LLM judge filter was run when the task was authored"
        },
        "expected_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "is_passing_v01": {
          "type": "boolean"
        },
        "required_signals_v01": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "author_note": {
          "type": "string",
          "description": "original authoring instruction (may state the expected verdict) - never shown to the writer"
        },
        "scenario": {
          "type": "string"
        },
        "brief_reconstructed": {
          "type": "boolean"
        },
        "reconstruction_note": {
          "type": "string"
        }
      }
    }
  },
